rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // UI environment variables do NOT authorize access. This exact UID does.
      return request.auth != null
        && request.auth.uid == 'a4ARjp0z8ZOByKlC2AfGzmMRj843';
    }
    function validWorkspace(data) {
      // Rules validate the bounded wrapper; strict application validators check
      // parsed JSON, money, links, image sources and the public allowlist.
      return data.keys().hasAll(['schemaVersion', 'revision', 'payload'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'payload'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1
        && data.revision <= 9007199254740991
        && data.payload is string && data.payload.size() > 0
        && data.payload.toUtf8().size() <= 700000;
    }
    function publishingWithDraft(revision) {
      // Publication must atomically advance the owner workspace. A standalone
      // public write cannot reuse a previously saved workspace revision.
      let workspace = /databases/$(database)/documents/ownerWorkspace/current;
      return validWorkspace(getAfter(workspace).data)
        && getAfter(workspace).data.revision == revision
        && ((!exists(workspace) && revision == 1)
          || (exists(workspace) && revision == get(workspace).data.revision + 1));
    }
    match /ownerWorkspace/current {
      allow get: if isOwner();
      allow create: if isOwner() && validWorkspace(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isOwner() && validWorkspace(resource.data)
        && validWorkspace(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    function validSiteAccess(data) {
      // This is the ONLY anonymously readable configuration. Never add private
      // contact details, owner identifiers, drafts or arbitrary extra fields.
      return data.keys().hasAll(['schemaVersion', 'revision', 'constructionMode'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'constructionMode'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1
        && data.revision <= 9007199254740991
        && data.constructionMode is bool;
    }
    function isPublicSiteOpen() {
      let access = /databases/$(database)/documents/site/access;
      // No document, invalid data, and read errors all fail closed. The old
      // server environment setting cannot grant direct Firestore access.
      return exists(access) && validSiteAccess(get(access).data)
        && get(access).data.constructionMode == false;
    }
    function canApplySiteAccess(data) {
      let publication = /databases/$(database)/documents/site/published;
      // Closing does not depend on a publication. Opening requires an already
      // saved public wrapper; the owner SDK additionally validates parsed JSON.
      return data.constructionMode == true
        || (exists(publication) && validWorkspace(get(publication).data));
    }
    match /site/access {
      allow get: if isOwner() || validSiteAccess(resource.data);
      allow create: if isOwner() && validSiteAccess(request.resource.data)
        && request.resource.data.revision == 1 && canApplySiteAccess(request.resource.data);
      allow update: if isOwner() && validSiteAccess(resource.data)
        && validSiteAccess(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && canApplySiteAccess(request.resource.data);
      allow list, delete: if false;
    }
    match /site/published {
      // Runtime access is authoritative here as well as in the application:
      // construction mode blocks direct anonymous REST/SDK publication reads.
      allow get: if isOwner() || (isPublicSiteOpen() && validWorkspace(resource.data));
      allow create: if isOwner() && validWorkspace(request.resource.data)
        && publishingWithDraft(request.resource.data.revision)
        && matchingPublishedAssets(request.resource.data.revision);
      allow update: if isOwner() && validWorkspace(resource.data)
        && validWorkspace(request.resource.data)
        && request.resource.data.revision > resource.data.revision
        && publishingWithDraft(request.resource.data.revision)
        && matchingPublishedAssets(request.resource.data.revision);
      allow list, delete: if false;
    }
    function validDraftId(id) {
      return id is string && id.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$');
    }
    function validDraftIndex(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'drafts', 'changedDraftId'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'drafts', 'changedDraftId'])
        && data.schemaVersion == 1 && data.schemaVersion is int
        && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && data.drafts is map && data.drafts.size() <= 10
        && validDraftId(data.changedDraftId);
    }
    function advancingDraftIndex(id) {
      let path = /databases/$(database)/documents/ownerDraftIndex/current;
      return validDraftIndex(getAfter(path).data)
        && getAfter(path).data.changedDraftId == id
        && ((!exists(path) && getAfter(path).data.revision == 1)
          || (exists(path) && getAfter(path).data.revision == get(path).data.revision + 1));
    }
    function indexedDraftAfter(id, revision) {
      let index = getAfter(/databases/$(database)/documents/ownerDraftIndex/current).data;
      return advancingDraftIndex(id) && id in index.drafts && index.drafts[id] == revision;
    }
    function validRegistryChange(data, before) {
      let id = data.changedDraftId;
      let active = /databases/$(database)/documents/ownerDrafts/$(id);
      let archive = /databases/$(database)/documents/ownerDraftTrash/$(id);
      return data.drafts.diff(before).affectedKeys().hasOnly([id])
        && data.drafts.diff(before).affectedKeys().size() == 1
        && ((id in data.drafts
          && existsAfter(active) && validWorkspace(getAfter(active).data)
          && data.drafts[id] == getAfter(active).data.revision
          && ((!(id in before) && !exists(active) && !exists(archive) && data.drafts[id] == 1)
            || (id in before && exists(active) && get(active).data.revision == before[id]
              && data.drafts[id] == before[id] + 1)))
          || (!(id in data.drafts) && id in before && exists(active)
            && get(active).data.revision == before[id] && !existsAfter(active)
            && existsAfter(archive) && getAfter(archive).data == get(active).data));
    }
    match /ownerDraftIndex/current {
      allow get: if isOwner();
      allow create: if isOwner() && validDraftIndex(request.resource.data)
        && request.resource.data.revision == 1 && validRegistryChange(request.resource.data, {});
      allow update: if isOwner() && validDraftIndex(resource.data) && validDraftIndex(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && validRegistryChange(request.resource.data, resource.data.drafts);
      allow list, delete: if false;
    }
    match /ownerDrafts/{draftId} {
      allow get: if isOwner();
      allow create: if isOwner() && validDraftId(draftId) && validWorkspace(request.resource.data)
        && request.resource.data.revision == 1
        && !exists(/databases/$(database)/documents/ownerDraftTrash/$(draftId))
        && indexedDraftAfter(draftId, 1);
      allow update: if isOwner() && validWorkspace(resource.data) && validWorkspace(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && indexedDraftAfter(draftId, request.resource.data.revision);
      // Removal is an atomic archive, never permanent destruction of content.
      allow delete: if isOwner() && advancingDraftIndex(draftId)
        && !(draftId in getAfter(/databases/$(database)/documents/ownerDraftIndex/current).data.drafts)
        && getAfter(/databases/$(database)/documents/ownerDraftTrash/$(draftId)).data == resource.data;
      allow list: if false;
    }
    match /ownerDraftTrash/{draftId} {
      allow get, list: if isOwner();
      allow create: if isOwner() && validDraftId(draftId) && validWorkspace(request.resource.data)
        && advancingDraftIndex(draftId)
        && !(draftId in getAfter(/databases/$(database)/documents/ownerDraftIndex/current).data.drafts)
        && exists(/databases/$(database)/documents/ownerDrafts/$(draftId))
        && !existsAfter(/databases/$(database)/documents/ownerDrafts/$(draftId))
        && request.resource.data == get(/databases/$(database)/documents/ownerDrafts/$(draftId)).data;
      // Restoration copies into a NEW active draft under the normal ten-slot limit.
      // The archived original remains recoverable; no purge endpoint is enabled.
      allow update, delete: if false;
    }
    function commissionStatus(data) {
      return data.get('status', 'received');
    }
    function commissionVersion(data) {
      return data.get('version', 0);
    }
    function validCommissionBefore(data) {
      return commissionStatus(data) in ['received', 'approved', 'denied', 'waitlisted']
        && commissionVersion(data) is int && commissionVersion(data) >= 0
        && commissionVersion(data) < 9007199254740991;
    }
    function validCommissionDecision(before, after) {
      return validCommissionBefore(before)
        && after.diff(before).affectedKeys().hasOnly(['status', 'version', 'updatedAt', 'updatedBy'])
        && after.keys().hasAll(['status', 'version', 'updatedAt', 'updatedBy'])
        && after.status in ['approved', 'denied', 'waitlisted']
        && after.status != commissionStatus(before)
        && after.version is int && after.version == commissionVersion(before) + 1
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time;
    }
    function validCommissionHistory(before, after, audit) {
      return audit.keys().hasAll(['fromStatus', 'toStatus', 'version', 'actorUid', 'createdAt'])
        && audit.keys().hasOnly(['fromStatus', 'toStatus', 'version', 'actorUid', 'createdAt'])
        && audit.fromStatus == commissionStatus(before) && audit.toStatus == after.status
        && audit.version == after.version && audit.version is int
        && audit.actorUid == request.auth.uid && audit.createdAt == request.time;
    }
    match /commissionRequests/{requestId} {
      // Existing private requests may be reviewed, never submitted, deleted,
      // emailed or charged by this owner-only decision path.
      allow get, list: if isOwner();
      allow update: if isOwner() && validCommissionDecision(resource.data, request.resource.data)
        && !exists(/databases/$(database)/documents/commissionRequests/$(requestId)/history/$(string(request.resource.data.version)))
        && validCommissionHistory(resource.data, request.resource.data,
          getAfter(/databases/$(database)/documents/commissionRequests/$(requestId)/history/$(string(request.resource.data.version))).data);
      allow create, delete: if false;
      match /history/{historyId} {
        allow get, list: if isOwner();
        allow create: if isOwner()
          && exists(/databases/$(database)/documents/commissionRequests/$(requestId))
          && historyId == string(request.resource.data.version)
          && validCommissionDecision(
            get(/databases/$(database)/documents/commissionRequests/$(requestId)).data,
            getAfter(/databases/$(database)/documents/commissionRequests/$(requestId)).data)
          && validCommissionHistory(
            get(/databases/$(database)/documents/commissionRequests/$(requestId)).data,
            getAfter(/databases/$(database)/documents/commissionRequests/$(requestId)).data,
            request.resource.data);
        allow update, delete: if false;
      }
    }
    // The rules-readable allowlist is committed in the same transaction as the
    // JSON publication. Draft metadata and private files are never public.
    function validPublishedAssets(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'ids'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'ids'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && data.ids is list && data.ids.size() <= 500;
    }
    function matchingPublishedAssets(revision) {
      let index = getAfter(/databases/$(database)/documents/site/publishedAssets).data;
      return validPublishedAssets(index) && index.revision == revision;
    }
    function publishingAssetsWithSite(revision) {
      let publication = /databases/$(database)/documents/site/published;
      return publishingWithDraft(revision)
        && validWorkspace(getAfter(publication).data)
        && getAfter(publication).data.revision == revision
        && (!exists(publication) || revision > get(publication).data.revision);
    }
    match /site/publishedAssets {
      allow get: if isOwner();
      allow create: if isOwner() && validPublishedAssets(request.resource.data)
        && publishingAssetsWithSite(request.resource.data.revision);
      allow update: if isOwner() && validPublishedAssets(resource.data)
        && validPublishedAssets(request.resource.data)
        && request.resource.data.revision > resource.data.revision
        && publishingAssetsWithSite(request.resource.data.revision);
      allow list, delete: if false;
    }
    function validCloudId(id) {
      return id is string && id.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$');
    }
    function validCloudName(name) {
      return name is string && name.size() > 0 && name.size() <= 150
        && name != '.' && name != '..'
        && name.matches('^\\S(.*\\S)?$')
        && !name.matches('.*[/\\\\].*')
        && !name.matches('.*[\\x00-\\x1F\\x7F].*');
    }
    function validCloudTime(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
    }
    function validCloudFile(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'kind', 'name', 'parentId', 'contentType', 'bytes', 'width', 'height', 'status', 'trashedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'kind', 'name', 'parentId', 'contentType', 'bytes', 'width', 'height', 'status', 'trashedAt', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && validCloudName(data.name)
        && (data.parentId == 'root' || validCloudId(data.parentId))
        && data.status in ['uploading', 'ready', 'deleting']
        && (data.trashedAt == null || validCloudTime(data.trashedAt))
        && validCloudTime(data.createdAt) && validCloudTime(data.updatedAt)
        && data.bytes is int && data.bytes > 0
        && data.width is int && data.height is int
        && ((data.kind == 'photo' && data.contentType == 'image/webp'
          && data.bytes <= 12582912 && data.width > 0 && data.width <= 4096
          && data.height > 0 && data.height <= 4096)
          || (data.kind == 'pdf' && data.contentType == 'application/pdf'
          && data.bytes <= 500000000 && data.width == 0 && data.height == 0)
          || (data.kind == 'file' && data.contentType == 'application/octet-stream'
          && data.bytes <= 500000000 && data.width == 0 && data.height == 0)
          || (data.kind == 'font' && data.contentType in ['font/woff', 'font/woff2', 'font/ttf', 'font/otf']
          && data.bytes <= 4000000 && data.width == 0 && data.height == 0));
    }
    function validCloudFolders(data) {
      // The owner client validates the complete bounded folder graph, including
      // cycles and depth. One registry revision serializes graph edits.
      return data.keys().hasAll(['schemaVersion', 'revision', 'folders'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'folders'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && data.folders is map && data.folders.size() <= 200
        && (!('00000000-0000-4000-8000-000000000001' in data.folders)
          || data.folders['00000000-0000-4000-8000-000000000001'] == {'name': 'Fonts', 'parentId': 'root', 'trashedAt': null});
    }
    function activeCloudParent(parentId) {
      let registry = /databases/$(database)/documents/ownerFileFolders/current;
      return parentId == 'root' || (exists(registry)
        && validCloudFolders(get(registry).data)
        && parentId in get(registry).data.folders
        && get(registry).data.folders[parentId] is map
        && get(registry).data.folders[parentId].trashedAt == null);
    }
    match /ownerFiles/{fileId} {
      allow get, list: if isOwner();
      allow create: if isOwner() && validCloudId(fileId) && validCloudFile(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.status == 'uploading'
        && request.resource.data.trashedAt == null && activeCloudParent(request.resource.data.parentId);
      allow update: if isOwner() && validCloudId(fileId) && validCloudFile(resource.data)
        && resource.data.status != 'deleting' && request.resource.data.status != 'deleting'
        && validCloudFile(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'parentId', 'status', 'trashedAt', 'updatedAt', 'revision'])
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == 'uploading' && request.resource.data.status == 'ready'))
        && ((request.resource.data.parentId == resource.data.parentId
          && !(resource.data.trashedAt != null && request.resource.data.trashedAt == null))
          || activeCloudParent(request.resource.data.parentId));
      // Only the authenticated maintenance service may reserve/purge files. Owner SDK deletes remain forbidden.
      allow delete: if false;
    }
    match /ownerFileFolders/current {
      allow get: if isOwner();
      allow create: if isOwner() && validCloudFolders(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isOwner() && validCloudFolders(resource.data)
        && validCloudFolders(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && (!('00000000-0000-4000-8000-000000000001' in resource.data.folders)
          || '00000000-0000-4000-8000-000000000001' in request.resource.data.folders);
      allow list, delete: if false;
    }

    // Private presentation order. It grants no access to bytes or public asset references.
    match /ownerFileOrder/{parentId} {
      function validOrder(data) {
        return data.keys().hasAll(['schemaVersion', 'revision', 'keys'])
          && data.keys().hasOnly(['schemaVersion', 'revision', 'keys'])
          && data.schemaVersion == 1 && data.revision is int && data.revision >= 1
          && data.revision <= 9007199254740991 && data.keys is list
          && data.keys.size() <= 5000 && data.keys.toSet().size() == data.keys.size();
      }
      allow get: if isOwner() && (parentId == 'root' || validCloudId(parentId));
      allow create: if isOwner() && activeCloudParent(parentId) && validOrder(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isOwner() && activeCloudParent(parentId) && validOrder(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }

    function validInventory(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'name', 'kind', 'categoryId', 'barcode', 'tags', 'quantity', 'unit', 'lowStock', 'notes', 'archived', 'createdAt', 'updatedAt', 'history'])
        && data.keys().hasOnly(['schemaVersion', 'revision', 'name', 'kind', 'categoryId', 'barcode', 'tags', 'quantity', 'unit', 'lowStock', 'notes', 'archived', 'createdAt', 'updatedAt', 'history'])
        && data.schemaVersion == 1 && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.name.matches('.*\\S.*') && !data.name.matches('.*[\\x00-\\x1F\\x7F].*')
        && (data.kind in ['material', 'finished'] || validCloudId(data.kind))
        && (data.categoryId == '' || validCloudId(data.categoryId))
        && data.barcode is string && data.barcode.matches('^[A-Z0-9.-]{1,24}$')
        && data.tags is list && data.tags.size() <= 20
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000
        && data.lowStock is number && data.lowStock >= 0 && data.lowStock <= 1000000
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 30
        && data.notes is string && data.notes.size() <= 2000 && data.archived is bool
        && validCloudTime(data.createdAt) && validCloudTime(data.updatedAt)
        && data.history is list && data.history.size() <= 30;
    }
    match /ownerInventory/{itemId} {
      allow get, list: if isOwner();
      allow create: if isOwner() && validCloudId(itemId) && validInventory(request.resource.data) && request.resource.data.revision == 1
        && request.resource.data.lowStock * 2 == int(request.resource.data.lowStock * 2);
      allow update: if isOwner() && validInventory(resource.data) && validInventory(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.lowStock == resource.data.lowStock || request.resource.data.lowStock * 2 == int(request.resource.data.lowStock * 2));
      allow delete: if false;
    }
    function validInventoryCategories(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'categories']) && data.keys().hasOnly(['schemaVersion', 'revision', 'categories', 'itemTypes', 'units'])
        && data.schemaVersion == 1 && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
        && data.categories is list && data.categories.size() <= 200
        && (!('itemTypes' in data) || (data.itemTypes is list && data.itemTypes.size() <= 200))
        && (!('units' in data) || (data.units is list && data.units.size() <= 200));
    }
    match /ownerInventorySettings/categories {
      allow get: if isOwner();
      allow create: if isOwner() && validInventoryCategories(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isOwner() && validInventoryCategories(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /ownerInventoryBarcodes/{barcodeKey} {
      allow get, list: if isOwner();
      allow create: if isOwner() && barcodeKey.matches('^[a-f0-9]{2,50}$')
        && request.resource.data.keys().hasOnly(['itemId']) && request.resource.data.keys().hasAll(['itemId'])
        && validCloudId(request.resource.data.itemId);
      // A reservation cannot be transferred to another item, including direct SDK writes.
      allow update: if isOwner() && request.resource.data == resource.data;
      allow delete: if isOwner();
    }

    // No access to other documents, collection listing or public owner data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
